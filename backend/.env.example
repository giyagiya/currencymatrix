# PostgreSQL connection
DATABASE_URL=postgres://remit:remit_password@localhost:5432/remit
# Set to true when your Postgres host needs SSL (Render, Neon, Supabase, RDS…)
DATABASE_SSL=false
# Long random text – keep secret. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-secret
# Port for the API
PORT=3000
# Angular site address allowed to call the API (comma separated). * = any
CORS_ORIGIN=http://localhost:4200
